{
  "name": "@dsp/monorepo",
  "version": "0.1.0",
  "devDependencies": {
    "changesets": "^1.0.2",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "syncpack": "^14.0.0-alpha.32",
    "turbo": "^2.7.2"
  },
  "packageManager": "bun@1.3.2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo && rm -rf node_modules",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "lint:format": "prettier --cache --check \"**/*.{js,ts,tsx,md,mdx,json}\"",
    "lint:format:fix": "prettier --cache --write \"**/*.{js,ts,tsx,md,mdx,json}\"",
    "lint:packages": "syncpack lint",
    "lint:packages:fix": "syncpack fix",
    "lint:packages:format": "syncpack format",
    "lint:packages:update": "syncpack update",
    "lint:packages:update:minor": "syncpack update --target minor",
    "lint:packages:update:patch": "syncpack update --target patch",
    "prepare": "husky",
    "reset": "bun run clean && bun install && bun run build",
    "start": "turbo run start",
    "test": "turbo run test"
  },
  "type": "module",
  "workspaces": [
    "examples/*",
    "packages/*"
  ]
}
