{
  "name": "@potrepka/native-audio",
  "version": "0.1.0",
  "author": "Nathaniel Potrepka",
  "repository": {
    "type": "git",
    "url": "https://github.com/potrepka/DSP.git",
    "directory": "packages/native-audio"
  },
  "main": "dist/index.js",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "^1.3.4",
    "eslint": "9.39.2",
    "eslint-plugin-perfectionist": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.7.4",
    "syncpack": "^13.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "peerDependencies": {
    "react-native": ">=0.82.0"
  },
  "description": "High-performance audio DSP library for TypeScript with Web and React Native support",
  "files": [
    "dist/",
    "web/",
    "ios/",
    "android/"
  ],
  "keywords": [
    "audio",
    "dsp",
    "web-audio",
    "react-native",
    "wasm",
    "jsi",
    "audio-processing",
    "synthesizer",
    "effects"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run build:web && npm run build:ts",
    "build:web": "bash scripts/build-web.sh",
    "build:ts": "tsc",
    "clean": "rm -rf dist/ web/build/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:format": "prettier --cache --check \"**/*.{js,ts,md,json,html,css}\"",
    "lint:format:fix": "prettier --cache --write \"**/*.{js,ts,md,json,html,css}\"",
    "lint:packages": "syncpack lint",
    "lint:packages:fix": "syncpack fix",
    "lint:packages:format": "syncpack format",
    "lint:packages:update": "syncpack update",
    "lint:packages:update:minor": "syncpack update --target minor",
    "lint:packages:update:patch": "syncpack update --target patch"
  },
  "types": "dist/index.d.ts"
}
