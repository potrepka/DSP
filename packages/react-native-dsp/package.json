{
  "name": "@potrepka/react-native-dsp",
  "description": "High-performance audio DSP library for TypeScript with Web and React Native support",
  "version": "0.1.0",
  "author": "Nathaniel Potrepka",
  "dependencies": {
    "nanoid": "^5.1.6",
    "react-native-audio-api": "^0.10.3"
  },
  "devDependencies": {
    "@dsp/eslint-config": "workspace:*",
    "@types/bun": "^1.3.5",
    "eslint": "^9.39.2",
    "react-native": "^0.83.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./web/build/react-native-dsp.js": "./web/build/react-native-dsp.js"
  },
  "files": [
    "android/",
    "dist/",
    "ios/",
    "shared/",
    "web/"
  ],
  "keywords": [
    "audio",
    "audio-processing",
    "dsp",
    "effects",
    "jsi",
    "react-native",
    "synthesizer",
    "wasm",
    "web-audio"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "peerDependencies": {
    "react-native": ">=0.82.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/potrepka/DSP.git",
    "directory": "packages/react-native-dsp"
  },
  "scripts": {
    "prebuild": "rm -rf shared/lib shared/src && cp -r ../../lib shared/lib && cp -r ../../src shared/src",
    "build": "npm run build:ts && npm run build:web",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:web": "bash scripts/build-web.sh",
    "clean": "rm -rf .turbo dist node_modules shared/lib shared/src web/build",
    "lint": "eslint .",
    "test": "bun test"
  },
  "types": "dist/index.d.ts"
}
